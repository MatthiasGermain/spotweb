# ── Variables spécifiques à l'app "Notes de frais" (/ndf) ──────────────────
# Copier dans `.env` pour le dev local, et renseigner les mêmes clés dans le
# dashboard Vercel (Project Settings → Environment Variables) pour la prod.
# Ne jamais committer de vraies valeurs.

# Fournie par l'intégration Vercel Postgres / Neon (onglet Storage du projet
# Vercel). En local, lancer `npx prisma dev` et copier les URLs affichées.
DATABASE_URL=""
SHADOW_DATABASE_URL=""

# Secret de signature des cookies de session (JWT) de l'app NDF.
#   openssl rand -hex 32
SESSION_SECRET=""

# Fournie par l'intégration Vercel Blob (onglet Storage du projet Vercel).
BLOB_READ_WRITE_TOKEN=""

# SMTP pour l'email de notification à chaque soumission de note de frais
# (compte OVH de l'association, indépendant du Resend utilisé par le reste
# du site).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
